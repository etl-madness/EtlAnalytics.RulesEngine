## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
/dist/
# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
# Uncomment if you use Visual Studio Code
.vscode/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
/*.VisualState.xml
/*.TestResult.xml

# Build log of MSBuild
*.log
*.log.bak
*.log.old

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Windows image-cache files
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycled Bin used on certain older Windows versions
$RECYCLE.BIN/

# Various MSBuild generated files
Generated\ Files/
[Bb]in/
[Oo]bj/
dotnet-tools.json

# Visual Studio vsprops
*.vsprops

# Others
*.Cache
ClientBin/
~$*
*~
*.dbmdl
*.dbproj.user
*.resharper
*.opendb
*.VC.db

# JetBrains Rider
.idea/
*.sln.iml

# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if using NuGet repositories to store project-specific packages (not recomendado)
# !**/[Pp]ackages/

# SQL Server files
*.mdf
*.ldf
*.ndf

# Business Intelligence projects
*.rdl.data
*.bim.layout
*.bim_*.settings
*.rptproj.rsuser
*- [Bb]ackup.rdl
*- [Bb]ackup ([0-9]*).rdl
*- [Bb]ackup.rdl.data

# Microsoft Azure Build Output
csx/
*.cscfg
*.csdef
*.ccproj
*.rdreq
*.rdalloc
*.ctcfg
*.blob
*.pubxml
*.azurePubxml
*.azproj

# Folder for code coverage: ProjectRoot/TestResults/
[Tt]est[Rr]esults/

# AppSettings secrets
appsettings.Development.json
secrets.json

# Antigravity artifacts
.gemini/
